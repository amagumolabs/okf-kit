{
  "name": "okf-kit",
  "version": "0.4.1",
  "private": true,
  "description": "OpenSpec + OKF workflow kit: schema, templates, and a dependency-free validator",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "okf": "bin/okf.mjs"
  },
  "files": [
    "bin",
    "lib",
    "openspec/config.yaml",
    "openspec/schemas",
    ".okf/README.md",
    ".okf/profile.md",
    ".okf/templates",
    "AGENTS.md",
    "CLAUDE.md"
  ],
  "scripts": {
    "check": "node bin/okf.mjs check",
    "index": "node bin/okf.mjs index",
    "test": "node test/run.mjs"
  },
  "license": "UNLICENSED"
}
