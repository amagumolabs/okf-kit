{
  "name": "okf-kit",
  "version": "0.5.0",
  "private": true,
  "description": "OpenSpec + OKF workflow kit: schema, templates, and a dependency-free validator",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "okf": "bin/okf.mjs"
  },
  "files": [
    "bin",
    "lib",
    "openspec/config.yaml",
    "openspec/schemas",
    ".okf/README.md",
    ".okf/profile.md",
    ".okf/templates",
    "AGENTS.md",
    "CLAUDE.md"
  ],
  "scripts": {
    "check": "node bin/okf.mjs check",
    "check:archive": "node bin/okf.mjs check --archive",
    "index": "node bin/okf.mjs index",
    "lint": "for f in bin/*.mjs lib/*.mjs test/*.mjs; do node --check \"$f\" || exit 1; done && echo \"node --check: all files parse\"",
    "test": "node test/run.mjs"
  },
  "license": "UNLICENSED"
}
